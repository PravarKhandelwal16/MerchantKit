APP_NAME="Merchant-as-a-Tool Agent Gateway"
DATABASE_URL="sqlite:///./data/gateway.db"

# LLM Provider: "gemini" (default) or "ollama"
LLM_PROVIDER=gemini

# Gemini Cloud LLM Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama Configuration (optional fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
